@model EventFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<input type="hidden" asp-for="EventId" />
<input type="hidden" asp-for="ExistingBannerUrl" />

<div class="row g-3">
    <div class="col-12">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" autofocus />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" class="form-control" type="date" />
        <span asp-validation-for="EventDate" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" class="form-control" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="DistanceKm" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="EventType" class="form-label"></label>
        <select asp-for="EventType" class="form-select">
            <option value="">Choose a type...</option>
            <option value="Run">Run</option>
            <option value="Walk">Walk</option>
            <option value="Cycle">Cycle</option>
        </select>
        <span asp-validation-for="EventType" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="BannerFile" class="form-label"></label>
        @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
        {
            <div class="mb-2">
                <img class="banner-preview" src="@Model.ExistingBannerUrl" alt="Current banner" />
                <div class="form-text">Current banner. Choose a new image below to replace it.</div>
            </div>
        }
        <input asp-for="BannerFile" class="form-control" type="file" accept="image/jpeg,image/png,image/webp" />
        <div class="form-text">JPEG, PNG or WebP, up to 5 MB. Optional.</div>
        <span asp-validation-for="BannerFile" class="text-danger small"></span>
    </div>
</div>
