@model HomeViewModel
@{
    ViewData["Title"] = "Events";
    var isLoggedIn = Context.Session.IsAuthenticated();
}

@if (!isLoggedIn)
{
    <section class="hero mb-4">
        <div class="hero-content">
            <h1 class="hero-title">Find your next <span>finish line</span></h1>
            <p class="hero-text">Browse runs, walks and rides, enter in a few taps, and keep every result in one place.</p>
            <a class="btn btn-primary btn-lg me-2" asp-controller="Account" asp-action="Register">Join RaceDay</a>
            <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Log in</a>
        </div>
    </section>
}
else
{
    <div class="mb-3">
        <h1 class="mb-1">Find your next race</h1>
        <p class="text-muted mb-0">Welcome back, @Context.Session.GetFullName()</p>
    </div>
}

@if (!string.IsNullOrEmpty(Model.LoadError))
{
    <div class="alert alert-warning">@Model.LoadError</div>
}

<form method="get" asp-controller="Home" asp-action="Index" class="filter-bar mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label for="q" class="form-label small mb-1">Search</label>
            <input id="q" name="q" class="form-control" placeholder="Event name or location" value="@Model.Filter.Q" />
        </div>
        <div class="col-md-2">
            <label for="type" class="form-label small mb-1">Type</label>
            <select id="type" name="type" class="form-select">
                <option value="">All types</option>
                <option value="Run" selected="@(Model.Filter.Type == "Run")">Run</option>
                <option value="Walk" selected="@(Model.Filter.Type == "Walk")">Walk</option>
                <option value="Cycle" selected="@(Model.Filter.Type == "Cycle")">Cycle</option>
            </select>
        </div>
        <div class="col-md-2">
            <label for="from" class="form-label small mb-1">From</label>
            <input id="from" name="from" type="date" class="form-control" value="@Model.Filter.From?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-2">
            <label for="to" class="form-label small mb-1">To</label>
            <input id="to" name="to" type="date" class="form-control" value="@Model.Filter.To?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">Filter</button>
            @if (Model.Filter.IsActive)
            {
                <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Clear</a>
            }
        </div>
    </div>
</form>

@if (Model.TotalUpcoming == 0)
{
    <div class="card">
        <div class="card-body empty-state">
            <h2 class="h4">No upcoming events yet</h2>
            <p class="mb-0">Check back soon. New races are added all the time.</p>
        </div>
    </div>
}
else if (!Model.Events.Any())
{
    <div class="card">
        <div class="card-body empty-state">
            <h2 class="h4">No events match your filters</h2>
            <p>Try a different search, type or date range.</p>
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Clear filters</a>
        </div>
    </div>
}
else
{
    <p class="text-muted">Showing @Model.Events.Count of @Model.TotalUpcoming upcoming @(Model.TotalUpcoming == 1 ? "event" : "events")</p>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var e in Model.Events)
        {
            <div class="col">
                <partial name="_EventCard" model="e" />
            </div>
        }
    </div>
}
