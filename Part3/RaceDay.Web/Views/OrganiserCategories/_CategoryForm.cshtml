@model CategoryFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<input type="hidden" asp-for="EventId" />
<input type="hidden" asp-for="CategoryId" />

<div class="row g-3">
    <div class="col-12">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="For example 10km Race or Under 20" autofocus />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" class="form-control" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="DistanceKm" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="Price" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="MaxParticipants" class="form-label"></label>
        <input asp-for="MaxParticipants" class="form-control" type="number" step="1" min="1" />
        <span asp-validation-for="MaxParticipants" class="text-danger small"></span>
    </div>
</div>
