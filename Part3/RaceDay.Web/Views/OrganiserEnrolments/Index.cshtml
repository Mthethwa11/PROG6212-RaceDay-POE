@model EnrolmentsPageViewModel
@{
    ViewData["Title"] = "Enrolments";
    ViewData["Tab"] = "Enrolments";
}

<partial name="_EventTabs" model="Model.Event" />

@if (!string.IsNullOrEmpty(Model.LoadError))
{
    <div class="alert alert-warning">@Model.LoadError</div>
}

@if (!Model.Enrolments.Any())
{
    <div class="card">
        <div class="card-body empty-state">
            <h2 class="h4">No enrolments yet</h2>
            <p>Participants will appear here as soon as they enter this event.</p>
        </div>
    </div>
}
else
{
    <p class="text-muted">
        @Model.Enrolments.Count(e => e.Status == "Confirmed") confirmed of @Model.Enrolments.Count
        @(Model.Enrolments.Count == 1 ? "enrolment" : "enrolments")
    </p>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-raceday align-middle mb-0">
                <thead>
                    <tr>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Enrolled on</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Enrolments)
                    {
                        <tr>
                            <td class="fw-semibold">@e.ParticipantName</td>
                            <td>@e.CategoryName</td>
                            <td>@e.EnrolmentDate.ToString("d MMM yyyy, HH:mm")</td>
                            <td><span class="status-badge status-@e.Status.ToLowerInvariant()">@e.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
