@model EventDto

<div class="card event-card">
    <a class="text-decoration-none" asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">
        <div class="card-img-wrap">
            @if (!string.IsNullOrEmpty(Model.BannerUrl))
            {
                <img class="event-card-img" src="@Model.BannerUrl" alt="Banner for @Model.Name" />
            }
            else
            {
                <div class="event-card-placeholder">@Model.EventType.ToUpperInvariant()</div>
            }
            <span class="event-date-chip">@Model.EventDate.ToString("d MMM")</span>
        </div>
    </a>
    <div class="card-body d-flex flex-column">
        <div class="mb-2">
            <span class="type-badge type-@Model.EventType.ToLowerInvariant()">@Model.EventType</span>
            <span class="text-muted small ms-1">@Model.DistanceKm.ToString("0.##") km</span>
        </div>
        <h3 class="h5 mb-1">@Model.Name</h3>
        <div class="text-muted small mb-3">@Model.Location &middot; @Model.WhenText</div>
        <a class="btn btn-primary mt-auto" asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">View details</a>
    </div>
</div>
