@model MyEventsViewModel
@{
    ViewData["Title"] = "My events";
}

<h1 class="mb-1">My events</h1>
<p class="text-muted mb-4">Every event you've entered, and where each enrolment stands.</p>

@if (!string.IsNullOrEmpty(Model.LoadError))
{
    <div class="alert alert-warning">@Model.LoadError</div>
}

@if (!Model.Upcoming.Any() && !Model.Past.Any())
{
    <div class="card">
        <div class="card-body empty-state">
            <h2 class="h4">You haven't entered anything yet</h2>
            <p>Find an event you like and pick a category.</p>
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Browse events</a>
        </div>
    </div>
}
else
{
    @if (Model.Upcoming.Any())
    {
        <div class="card mb-4">
            <div class="card-body p-4">
                <h2 class="h4 mb-3">Upcoming</h2>
                <div class="table-responsive">
                    <table class="table table-raceday align-middle mb-0">
                        <thead>
                            <tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th><th class="text-end">Actions</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var e in Model.Upcoming)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        <a class="text-decoration-none" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a>
                                    </td>
                                    <td>@e.EventDate.ToString("ddd, d MMM yyyy")</td>
                                    <td>@e.CategoryName</td>
                                    <td><span class="status-badge status-@e.Status.ToLowerInvariant()">@e.Status</span></td>
                                    <td class="text-end text-nowrap">
                                        <form asp-controller="MyEvents" asp-action="Cancel" asp-route-id="@e.EnrolmentId" method="post" class="d-inline"
                                              onsubmit="return confirm('Cancel your enrolment in @e.EventName?');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Cancel enrolment</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (Model.Past.Any())
    {
        <div class="card">
            <div class="card-body p-4">
                <h2 class="h4 mb-3">Past events</h2>
                <div class="table-responsive">
                    <table class="table table-raceday align-middle mb-0">
                        <thead>
                            <tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var e in Model.Past)
                            {
                                <tr>
                                    <td class="fw-semibold">@e.EventName</td>
                                    <td>@e.EventDate.ToString("ddd, d MMM yyyy")</td>
                                    <td>@e.CategoryName</td>
                                    <td><span class="status-badge status-@e.Status.ToLowerInvariant()">@e.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="small text-muted mt-3 mb-0">
                    Finish times and positions appear under <a asp-controller="MyResults" asp-action="Index">My results</a> once the organiser records them.
                </p>
            </div>
        </div>
    }
}
